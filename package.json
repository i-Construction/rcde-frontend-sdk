{
  "name": "@i-con/frontend-sdk",
  "version": "0.0.4",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "default": "./dist/index.es.js"
    },
    "./api-server": {
      "types": "./dist/api-server.d.ts",
      "import": "./dist/api-server.es.js",
      "default": "./dist/api-server.es.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "types"
  ],
  "scripts": {
    "dev": "vite example",
    "build": "tsc -b && vite build && vite build --config vite.api-server.config.ts && tsc -p tsconfig.api-server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cases": "node scripts/generate-test-cases.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.9.1",
    "@i-con/pcd-viewer": "github:AMDlab/pcd-viewer#feat/react19",
    "@mui/icons-material": "^6.2.0",
    "@mui/material": "^6.1.10",
    "@mui/x-date-pickers": "^7.23.1",
    "@xstate/react": "^5.0.0",
    "chroma-js": "^3.1.2",
    "date-fns": "^2.30.0",
    "js-quadtree": "^3.3.6",
    "pngjs": "^7.0.0",
    "react-hook-form": "^7.54.0",
    "xstate": "^5.19.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.2.0",
    "@mui/material": "^6.1.10",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@xstate/react": "^5.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/chroma-js": "^3.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "ajv": "^8.20.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1"
  },
  "volta": {
    "node": "22.21.1"
  }
}
