# === サーバーサイド専用（ブラウザには渡らない） ===
# RCDE のサイトで作成したアプリケーションの認証情報
# https://github.com/i-Construction/rcde-api-sdk#事前準備
RCDE_CLIENT_ID=
RCDE_CLIENT_SECRET=
RCDE_API_BASE_URL=https://api.rcde.jp

# === クライアントサイド（ブラウザに公開される） ===
# SDK の app.baseUrl に渡す値。CORS 回避のため自前プロキシを指す。
NEXT_PUBLIC_RCDE_PROXY_BASE_URL=/api/rcde

# 起動直後に表示する現場 / 契約（任意。未指定ならヘッダーのセレクタで選ぶ）
NEXT_PUBLIC_DEFAULT_CONSTRUCTION_ID=
NEXT_PUBLIC_DEFAULT_CONTRACT_ID=
